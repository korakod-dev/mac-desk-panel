// Local configuration. Copy to secrets.h and fill in your own values — the
// real file is gitignored, this template is not.
//
//     cp include/secrets.h.example include/secrets.h
//
#pragma once

// Leave these two as they are to run with no radio at all: net_link checks for
// the placeholder and skips bringing WiFi up, and the panel gets its network
// from tools/usb_net_bridge.py over the USB-C cable instead.
#define WIFI_SSID     "YOUR_WIFI_NAME"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Host running tools/usage_server.py, which serves the Claude Code usage
// limits read from ~/.claude/statusline-usage.cache. USAGE_HOST is the LAN
// address, used when the request goes out over WiFi; over the USB bridge the
// alias below is resolved to the bridge's own machine instead, so it keeps
// working wherever the laptop is connected. The alias must match
// USB_HOST_ALIAS in tools/usb_net_bridge.py.
#define USAGE_HOST     "192.168.1.10"
#define USAGE_HOST_USB "usb-host"
#define USAGE_PORT     8787

// tools/mac_stats_server.py, on the same machine and reached the same way.
#define MAC_PORT       8789

// Shared secret for reaching those two over WiFi. Requests that arrive over the
// USB bridge are made by the bridge on the host itself, so they reach the
// servers from loopback and are served without it; requests off the LAN are
// not. Both servers mint this on first run and keep it at
// ~/.config/t-display-s3/token, mode 0600 — copy the value from there.
//
// Leaving it as it is only costs the WiFi fallback: the panel keeps working
// over the cable, and the clock and weather work either way since neither
// touches your machine.
#define HOST_TOKEN     "PASTE_FROM_~/.config/t-display-s3/token"

// Location shown on the weather page. Defaults to Bangkok.
#define WEATHER_LAT   13.7563
#define WEATHER_LON   100.5018
#define WEATHER_PLACE "Bangkok"

// POSIX timezone for the clock, and the same zone URL-encoded for Open-Meteo.
// Note the POSIX sign convention is inverted: UTC+7 is written "-7".
// Thailand has no DST, so no rule follows the offset; a zone that does needs
// one, e.g. "CET-1CEST,M3.5.0,M10.5.0/3".
#define LOCAL_TZ       "ICT-7"
#define WEATHER_TZ_URL "Asia%2FBangkok"
